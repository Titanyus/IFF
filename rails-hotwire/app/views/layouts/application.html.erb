<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#142c45"><title>FF-Verwaltung · Rails + Hotwire</title>
  <%= csrf_meta_tags %><%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body>
  <header class="topbar">
    <div class="brand"><div class="brandmark">✳</div><div><strong>Frühförderung</strong><small>Verwaltung · Rails + Hotwire</small></div></div>
    <% if current_user %>
      <div class="account"><span><%= current_user.email %></span><%= button_to "Abmelden", session_path, method: :delete, class: "nav-btn" %></div>
    <% end %>
  </header>
  <main class="main">
    <% if notice.present? %><div class="notice"><%= notice %></div><% end %>
    <% if alert.present? %><div class="alert"><%= alert %></div><% end %>
    <%= yield %>
    <p class="footnote">Technischer PoC · ausschließlich fiktive Daten · nicht produktionsreif</p>
  </main>
</body>
</html>
